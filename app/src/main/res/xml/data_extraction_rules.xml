<?xml version="1.0" encoding="utf-8"?>
<!--
  안드로이드 12+ 의 백업·기기 이전 규칙. backup_rules.xml 과 같은 이유로
  매뉴얼(실명·연락처)을 클라우드 백업과 기기 이전 양쪽에서 모두 뺀다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="manual" />
        <exclude domain="file" path="manual.tmp" />
        <exclude domain="file" path="manual.old" />
        <exclude domain="sharedpref" path="manual_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="manual" />
        <exclude domain="file" path="manual.tmp" />
        <exclude domain="file" path="manual.old" />
        <exclude domain="sharedpref" path="manual_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
