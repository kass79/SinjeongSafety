<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      설정에서 "현재 위치 날씨"를 켠 사람만 쓴다. 위치를 추적하지 않고 다른 앱이 이미
      잡아둔 마지막 위치만 한 번 읽으며, 기상청 격자가 5km 단위라 대략적 위치면 충분하다.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      안드로이드 11부터는 다른 앱이 깔려 있는지 확인하려면 미리 선언해야 한다.
      이게 없으면 신정승무캘린더가 설치돼 있어도 "없다"고 판단해 계속 스토어로 보낸다.
    -->
    <queries>
        <package android:name="com.sinjeong.crewcalendar" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/mascot_sign"
        android:roundIcon="@drawable/mascot_sign"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SinjeongSafety">

        <!--
          configChanges: 동영상 전체화면이 화면을 가로로 돌리는데, 이 선언이 없으면
          회전이 액티비티를 재시작시켜 다이얼로그·재생 상태가 그 자리에서 깨진다
          (폴드 접은 화면에서 전체화면 오류로 실측). Compose는 재시작 없이도
          Configuration 변화를 스스로 반영하므로 잃는 것이 없다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SinjeongSafety">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM 수신 서비스 -->
        <service
            android:name=".fcm.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="new_posts" />

        <!-- 확인 현황 CSV를 다른 앱(카톡·메일)으로 넘기기 위한 통로 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
