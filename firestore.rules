rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 계정 하나만 글을 쓸 수 있다.
    // 승무원도 Firebase 로그인 상태이므로 "request.auth != null" 만으로는
    // 승무원이 글을 지울 수 있다. 반드시 이메일로 관리자를 특정한다.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@sinjeong.app';
    }

    // 로그인한 승무원 (사번@sinjeong.app)
    function isCrew() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.matches('^[0-9]{8}@sinjeong[.]app$');
    }

    match /posts/{postId} {
      // 읽기: 로그인 강제를 켜기 전까지는 누구나 읽을 수 있어야 한다.
      // (기존 버전 앱을 쓰는 사람이 갑자기 빈 화면을 보는 사고를 막는다)
      allow read: if true;

      allow create: if isAdmin() && validPost();
      allow delete: if isAdmin();

      // 수정: (a) 관리자의 정상 수정  또는  (b) 누구나 views/confirms 카운터 +1만
      allow update: if (isAdmin() && validPost())
                    || onlyCounterIncrement();

      function validPost() {
        return request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 200
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 20000;
      }

      // 조회수(views)와 확인 인원(confirms)은 로그인 없이도 +1 할 수 있어야 한다.
      // 예전에는 views만 허용해서 확인 카운터가 조용히 실패했다.
      // 댓글 수(commentCount)는 지울 때 -1도 해야 해서 양방향으로 열어 둔다.
      // 옛 글에는 commentCount 필드가 아예 없다. 그때 resource.data.commentCount 를
      // 읽으면 규칙이 통째로 실패해 첫 댓글이 막히므로, 없을 때는 1이 되는 것만 허용한다.
      function onlyCounterIncrement() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['views', 'confirms', 'commentCount'])
            && (!keys.hasAny(['views']) || request.resource.data.views == resource.data.views + 1)
            && (!keys.hasAny(['confirms']) || request.resource.data.confirms == resource.data.confirms + 1)
            && (!keys.hasAny(['commentCount'])
                || (!('commentCount' in resource.data)
                    ? request.resource.data.commentCount == 1
                    : (request.resource.data.commentCount == resource.data.commentCount + 1
                       || request.resource.data.commentCount == resource.data.commentCount - 1)));
      }

      // 확인 기록. 본인 사번 문서만 남길 수 있고, 명단 조회는 관리자만 한다.
      match /confirms/{empNo} {
        allow read: if isAdmin();
        allow write: if isCrew() && request.auth.token.email == empNo + '@sinjeong.app';
      }

      // 댓글. 실명제라 로그인한 사람만 쓰고, 지우는 건 관리자 또는 본인이다.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if (isCrew() || isAdmin())
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 2000
                      // 답글이면 부모 댓글 id가 들어온다(원댓글은 빈 문자열).
                      // 필수로 하지 않는다 — 예전 앱이 깔린 폰은 이 필드를 보내지 않아
                      // 필수로 걸면 그 사람들 댓글이 통째로 막힌다. 있을 때만 형식을 본다.
                      && (!('parentId' in request.resource.data)
                          || (request.resource.data.parentId is string
                              && request.resource.data.parentId.size() <= 200));
        allow delete: if isAdmin()
                      || (isCrew() && request.auth.token.email == resource.data.authorEmpNo + '@sinjeong.app');
        allow update: if false;
      }
    }

    // 승무원 정보 (이름, 접속 시각). 문서 id = 사번
    match /crew/{empNo} {
      // 본인 문서만 읽고 쓸 수 있다. 명단 전체를 긁어갈 수 없다.
      allow read, write: if isCrew()
                         && request.auth.token.email == empNo + '@sinjeong.app';
      // 관리자는 조회만 (초기화 대상 확인용)
      allow read: if isAdmin();
    }

    // 질의응답. 실명제라 로그인한 사람만 쓰고, 지우는 건 관리자만 한다.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if (isCrew() || isAdmin()) && validQuestion();
      allow delete: if isAdmin();
      // 본문 수정 기능은 없다. 조회수와 답변 수 카운터만 움직인다.
      allow update: if onlyQuestionCounters();

      function validQuestion() {
        return request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 200
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 5000;
      }

      function onlyQuestionCounters() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['views', 'answerCount'])
            && (!keys.hasAny(['views']) || request.resource.data.views == resource.data.views + 1)
            && (!keys.hasAny(['answerCount'])
                || request.resource.data.answerCount == resource.data.answerCount + 1
                || (isAdmin() && request.resource.data.answerCount == resource.data.answerCount - 1));
      }

      match /answers/{answerId} {
        allow read: if true;
        allow create: if (isCrew() || isAdmin())
                      && request.resource.data.content is string
                      && request.resource.data.content.size() > 0
                      && request.resource.data.content.size() <= 5000;
        allow delete: if isAdmin();
        allow update: if false;
      }
    }

    // 출무점호. 매일 관리자가 올리고 전 직원이 읽는다. 문서 id는 yyyyMMdd.
    match /briefings/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 로그인 강제 스위치. 앱은 읽기만 하고, 값 변경은 콘솔에서 한다.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
