rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{fileName} {
      // 모든 직원: 첨부파일 열람/다운로드 가능
      allow read: if true;
      // 업로드: 로그인한 관리자만, 파일당 20MB 제한
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
