rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{fileName} {
      // 모든 직원: 첨부파일 열람/다운로드 가능
      allow read: if true;
      // 업로드: 로그인한 사용자. 동영상만 1GB까지 받고 나머지는 50MB로 묶는다.
      // (앱의 검사와 같은 값이어야 한다 — 한쪽만 고치면 업로드가 조용히 실패한다)
      allow write: if request.auth != null
                   && (
                        (request.resource.contentType != null
                         && request.resource.contentType.matches('video/.*')
                         && request.resource.size < 1024 * 1024 * 1024)
                        || request.resource.size < 50 * 1024 * 1024
                      );
    }

    // 비상대응 현장조치 매뉴얼 (manual/manual.json, manual/images/*).
    // 실명이 들어 있어 공개 저장소·APK 에 두지 않고 여기서만 내려받는다.
    // 읽기: crew 커스텀 클레임을 받은 사람만. attachments 와 달리 공개하지 않는다.
    //   이메일 정규식으로는 부족하다 — 가입이 앱 안에서만 명단을 확인하므로 앱 밖에서
    //   아무 8자리@sinjeong.app 계정이나 만들 수 있다. 클레임은 verifyCrew 함수가
    //   Firestore config/roster 까지 대조한 뒤에만 붙인다.
    // 쓰기: 금지 — 업로드는 프로젝트 소유자가 콘솔에서 한다(규칙이 아니라 소유자 권한으로 통과).
    match /manual/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.crew == true;
      allow write: if false;
    }
  }
}
